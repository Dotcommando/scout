{
  "name": "@scout/discovery",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json --incremental false",
    "backfill": "node dist/adapters/inbound/cli/run-discovery-backfill.js",
    "capture:contract": "node dist/adapters/inbound/cli/capture-apify-contract.js contract-capture",
    "capture:contract:inspect": "node dist/adapters/inbound/cli/capture-apify-contract.js inspect",
    "lint": "eslint .",
    "live:execute": "node dist/adapters/inbound/cli/run-live-discovery-execution.js",
    "operations:summary": "node dist/adapters/inbound/cli/report-discovery-operations.js",
    "start": "node dist/adapters/inbound/http/main.js",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --runInBand",
    "test:e2e:live": "node dist/adapters/inbound/cli/run-live-discovery-e2e.js",
    "test:integration": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --runInBand test/integration",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@nestjs/common": "11.1.12",
    "@nestjs/core": "11.1.12",
    "@nestjs/platform-express": "11.1.12",
    "@nestjs/schedule": "6.1.1",
    "@scout/contracts": "file:../packages/contracts",
    "@types/amqplib": "0.10.8",
    "amqplib": "2.0.1",
    "dotenv": "17.2.3",
    "mongodb": "7.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "yaml": "2.8.1"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@nestjs/testing": "11.1.12",
    "@stylistic/eslint-plugin": "5.6.1",
    "@types/jest": "30.0.0",
    "@types/node": "24.10.1",
    "@typescript-eslint/eslint-plugin": "8.46.2",
    "@typescript-eslint/parser": "8.46.2",
    "eslint": "9.39.1",
    "eslint-plugin-simple-import-sort": "12.1.1",
    "globals": "16.5.0",
    "jest": "30.2.0",
    "ts-jest": "29.4.5",
    "typescript": "5.9.3"
  }
}
